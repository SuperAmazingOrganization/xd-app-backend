# Copy this file to .env and fill in real values. .env is gitignored.

# PostgreSQL connection (Supabase project -> Project Settings -> Database -> Connection string).
# Quote values that contain &, ?, =, or other shell-special characters.
SPRING_DATASOURCE_URL="jdbc:postgresql://<host>:<port>/postgres?user=postgres&password=<password>"
SPRING_DATASOURCE_USERNAME="postgres"
SPRING_DATASOURCE_PASSWORD=""

# JWT signing secret. MUST be >= 64 chars. Generate with: openssl rand -base64 64
APP_ACCESS_TOKEN_SECRET=""

# Supabase project -> Project Settings -> API
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_KEY=""
SUPABASE_BUCKET=""
